{
  "name": "aegov-new",
  "version": "4.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "build": "lerna run build --scope='{@aegov/designsystem,@aegov/designsystem-react,@aegov/designsystem-vue,@aegov/designsystem-angular}'",
    "build:all": "lerna run build",
    "build:libs": "lerna run build --scope='{@aegov/designsystem,@aegov/designsystem-react,@aegov/designsystem-vue}'",
    "build:affected": "lerna run build --since=origin/master --scope='{@aegov/designsystem,@aegov/designsystem-react,@aegov/designsystem-vue,@aegov/designsystem-angular}'",
    "release": "lerna publish from-package --yes",
    "test": "lerna run test",
    "clean": "lerna clean -y",
    "graph": "nx graph",
    "dev": "run-p dev:servers dev:open",
    "dev:servers": "lerna run dev --parallel --scope='{react-app,vue-app,angular-workspace,html-app}'",
    "dev:open": "./scripts/open-browsers.sh",
    "dev:all": "lerna run dev --parallel",
    "docs:dev": "cd packages/docs-site && npm run dev",
    "docs:public": "cd packages/public-docs && npm run dev",
    "test:html": "lerna run dev --scope=test-html",
    "test:react": "lerna run dev --scope=test-react",
    "test:vue": "lerna run dev --scope=test-vue",
    "test:angular": "lerna run dev --scope=test-angular",
    "test:apps": "lerna run dev --scope='{test-html,test-react,test-vue,test-angular}' --parallel"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "workspaces": [
    "packages/*",
    "test-apps/*"
  ],
  "devDependencies": {
    "@types/node": "^26.1.0",
    "lerna": "^9.0.7",
    "nx": "23.0.1",
    "patch-package": "8.0.1",
    "typescript": "^6.0.3"
  }
}
