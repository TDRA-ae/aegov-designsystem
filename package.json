{
  "name": "@aegov/design-system",
  "version": "0.1.0",
  "description": "AEGOV Design System - Framework-agnostic web components with Tailwind CSS",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/aegov/aegov.esm.js",
  "files": [
    "dist/",
    "loader/",
    "src/styles/"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./dist/components/*": {
      "import": "./dist/components/*",
      "types": "./dist/components/*"
    },
    "./css": "./dist/aegov/aegov.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./theme": "./src/styles/tailwind.css"
  },
  "scripts": {
    "build": "npm run build:docs-md && stencil build --docs && npm run build:docs-css",
    "build:prod": "npm run build:docs-md && NODE_ENV=production stencil build --docs && npm run build:docs-css",
    "build:docs-css": "npx tailwindcss -i src/doc-style/doc-style.css -o src/docs/doc-style.css",
    "build:docs-md": "node scripts/build-docs.js",
    "start": "node scripts/build-docs.js --watch & npx tailwindcss -i src/doc-style/doc-style.css -o src/docs/doc-style.css --watch & stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test:unit": "stencil test --spec",
    "test:e2e": "stencil test --e2e",
    "test:watch": "stencil test --spec --e2e --watchAll",
    "test:coverage": "stencil test --spec --coverage",
    "test:ci": "stencil test --spec --e2e --ci",
    "verify:build": "node scripts/verify-build.js",
    "test:build": "npm run build && npm run verify:build",
    "size": "size-limit",
    "generate": "stencil generate",
    "prepublishOnly": "npm run test:build"
  },
  "dependencies": {
    "@stencil/core": "^4.38.3"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@stencil/angular-output-target": "^0.9.0",
    "@stencil/react-output-target": "^0.8.0",
    "@stencil/sass": "^3.2.1",
    "@stencil/vue-output-target": "^0.8.9",
    "@tailwindcss/cli": "^4.2.1",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "highlight.js": "^11.11.1",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "marked": "^17.0.4",
    "postcss": "^8.4.49",
    "puppeteer": "^23.11.0",
    "size-limit": "^12.1.0",
    "stencil-tailwind-plugin": "^2.0.5",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "keywords": [
    "design-system",
    "web-components",
    "stencil",
    "tailwind",
    "aegov",
    "component-library",
    "react",
    "vue",
    "angular"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aegov/design-system"
  }
}
