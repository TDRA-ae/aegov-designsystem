# AI agent config and skills: local only, at any depth (root and packages/*)
.claude/
.agents/
skills-lock.json
/SKILL.md

# Live package verification (uses published npm packages, not workspace)
test-published/

# Local framework test apps (kept out of the repo and its history)
test-apps/

# Stencil auto-generated component docs (regenerated on every build)
packages/designsystem/src/components/**/readme.md

# npm pack tarballs
*.tgz

backup

# Local developer notes (not shared)
DEVELOPER.md
