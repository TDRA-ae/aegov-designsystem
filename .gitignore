npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Testing / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# TypeScript incremental build info
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# Editor / IDE
.idea/
.vscode/*
!.vscode/settings.json
